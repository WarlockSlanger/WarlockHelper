		<Loop id="held" path="held" delay="0.1"/>
		<Anim id="fall" path="fall" delay="0.06" goto="fallLoop"/>
		<Loop id="fallLoop" path="fallLoop" delay="0.06"/>
		<Anim id="death" path="death" delay="0.06"/>
  </warlockHelper_momentumGlider>
  
  <warlockHelper_chargeOverlay path="objects/WarlockHelper/momentumGlider/">
		<Justify x="0.5" y="0.58"/>
		<Anim id="on" path="chargeOverlay" delay="0.06"/>
  </warlockHelper_chargeOverlay>
  <warlockHelper_boosterBumper path="objects/WarlockHelper/boosterBumper/" start="idle">
      <Center/>
      <Anim id="on" path="idle" frames="42-50" delay="0.06" goto="idle"/>
      <Loop id="idle" path="idle" frames="0-33" delay="0.06"/>
      <Anim id="hit" path="idle" frames="34-42" delay="0.06" goto="off"/>
      <Loop id="off" path="idle" frames="42" delay="0.06"/>
  </warlockHelper_boosterBumper>
  <warlockHelper_boosterBumper_red path="objects/WarlockHelper/boosterBumper/" start="idle">
