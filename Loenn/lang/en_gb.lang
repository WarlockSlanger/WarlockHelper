# Generic
mods.WarlockHelper.name=Warlock Helper

# Booster Bumper
entities.WarlockHelper/BoosterBumper.placements.name.normal=Booster Bumper
entities.WarlockHelper/BoosterBumper.placements.description.normal=Bumper that makes you dash in the direction it is hit.
entities.WarlockHelper/BoosterBumper.placements.name.red=Booster Bumper (Red)
entities.WarlockHelper/BoosterBumper.placements.description.red=Bumper that causes a red dash in the direction it is hit.
entities.WarlockHelper/BoosterBumper.placements.name.super=Booster Bumper (Super)
entities.WarlockHelper/BoosterBumper.placements.description.super=Bumper that causes a super dash in the direction it is hit.
entities.WarlockHelper/BoosterBumper.attributes.description.snapDirection=Whether to snap 360-degree dash directions to the 8 normal directions.
entities.WarlockHelper/BoosterBumper.attributes.description.silentDash=If true, dashListeners (including Winged Strawberries and Swap Blocks) are not activated by the bumper.
entities.WarlockHelper/BoosterBumper.attributes.description.dashInterrupt=Whether the player can dash out of the bumper dash. Always true for super dashes.\nNote that the dash cooldown has to be disabled too for normal dashes.
entities.WarlockHelper/BoosterBumper.attributes.name.dashInterrupt=Allow Interrupting Dash
entities.WarlockHelper/BoosterBumper.attributes.description.dashCooldown=Whether the player's dash cooldown starts upon hitting the bumper.
entities.WarlockHelper/BoosterBumper.attributes.description.dashSuper=Whether the bumper causes a Super Dash. Doesn't affect Red bumpers.
entities.WarlockHelper/BoosterBumper.attributes.name.dashSuper=Super Dash
entities.WarlockHelper/BoosterBumper.attributes.description.snapPosition=Whether the player's position gets snapped to the corresponding point on the bumper's edge.
entities.WarlockHelper/BoosterBumper.attributes.description.respawnTime=How long the bumper takes to reactivate after hitting. Set to negative to make it one-use.
entities.WarlockHelper/BoosterBumper.attributes.description.direction=Changes the dash direction and speed. First 4 values are 2x2 matrix elements, 2 values after are a fixed offset vector.
entities.WarlockHelper/BoosterBumper.attributes.description.moveCycleTime=If the bumper has a node, the time for the bumper to move back and forth.

# Dash Direction Trigger
triggers.WarlockHelper/DashDirTrigger.placements.name.normal=Dash Direction Trigger
triggers.WarlockHelper/DashDirTrigger.placements.description.normal=Trigger which alters the direction and speed of the player's dash.
triggers.WarlockHelper/DashDirTrigger.attributes.description.direction=Changes the dash direction. First 4 values are 2x2 matrix elements, 2 values after are a fixed offset vector.
triggers.WarlockHelper/DashDirTrigger.attributes.description.neutralLeft=Dash direction when the player isn't holding a direction and is facing left.
triggers.WarlockHelper/DashDirTrigger.attributes.description.neutralRight=Dash direction when the player isn't holding a direction and is facing right.
triggers.WarlockHelper/DashDirTrigger.attributes.description.overrideNeutral=Whether not holding a direction should dash forwards or in a custom direction (reopen menu for options).
triggers.WarlockHelper/DashDirTrigger.attributes.name._mode=Mode
triggers.WarlockHelper/DashDirTrigger.attributes.description._mode=Disable: resets dash direction to normal.\nMatrix: alters dash direction with a 2x2 matrix and offset.\nReplace: manually replaces the 8 dash directions.\nReopen the menu after changing for options.
triggers.WarlockHelper/DashDirTrigger.attributes.description.persistent=Allows the player's dash direction to not get reset upon death.

# Momentum Glider
entities.WarlockHelper/MomentumGlider.placements.name.normal=Momentum Jellyfish
entities.WarlockHelper/MomentumGlider.placements.description.normal=Jellyfish which flings the player with its momentum when picked up, and can keep the player's momentum when released
entities.WarlockHelper/MomentumGlider.attributes.description.throwGliderMomentum=How much the player's speed influences the jelly's speed when it's thrown.\n(X and Y scale respectively)
entities.WarlockHelper/MomentumGlider.attributes.description.throwGliderSpeed=Fixed speed added to jelly's when it's thrown.\nFlipped horizontally if facing left.
entities.WarlockHelper/MomentumGlider.attributes.description.throwPlayerMomentum=How much of the player's speed is kept when throwing.\n(X and Y scale respectively)
entities.WarlockHelper/MomentumGlider.attributes.description.throwPlayerSpeed=Fixed speed added to the player's when throwing.\nFlipped horizontally if facing left.
entities.WarlockHelper/MomentumGlider.attributes.description.dropGliderMomentum=As above, but for dropping instead of throwing.
entities.WarlockHelper/MomentumGlider.attributes.description.dropGliderSpeed=As above, but for dropping instead of throwing.
entities.WarlockHelper/MomentumGlider.attributes.description.dropPlayerMomentum=As above, but for dropping instead of throwing.
entities.WarlockHelper/MomentumGlider.attributes.description.dropPlayerSpeed=As above, but for dropping instead of throwing.
entities.WarlockHelper/MomentumGlider.attributes.description.pickupGliderMomentum=How much the glider's momentum contributes to the player's upon pickup.\n(X and Y scale respectively)
entities.WarlockHelper/MomentumGlider.attributes.description.pickupPlayerMomentum=How much of the player's speed is retained upon pickup.\n(X and Y scale respectively)
entities.WarlockHelper/MomentumGlider.attributes.description.pickupSpeed=Fixed speed added to the player's when picking the jelly up.\nFlipped horizontally if facing left.
entities.WarlockHelper/MomentumGlider.attributes.description.playerBoost=Player downwards speed is nullified.\nUpwards boost if moving up, dashing, hypering etc. upon pickup.\n(Applied before rescaling by pickupPlayerMomentum)\nJumping while grabbing or throwing the jelly will counteract its downwards momentum.
entities.WarlockHelper/MomentumGlider.attributes.description.gliderBoost=Low downwards speed from the jelly is ignored to make vators more consistent.

