# Generic
mods.WarlockHelper.name=Warlock Helper

# Booster Bumper
entities.WarlockHelper/BoosterBumper.placements.name.normal=Booster Bumper
entities.WarlockHelper/BoosterBumper.placements.description.normal=Bumper that makes you dash in the direction it is hit.
entities.WarlockHelper/BoosterBumper.placements.name.red=Booster Bumper (Red)
entities.WarlockHelper/BoosterBumper.placements.description.red=Bumper that causes a red booster-style dash in the direction it is hit.
entities.WarlockHelper/BoosterBumper.attributes.description.snapDirection=Whether to snap 360-degree dash directions to the 8 normal directions.
entities.WarlockHelper/BoosterBumper.attributes.description.direction=Changes the dash direction. First 4 values are 2x2 matrix elements, 2 optional values after are a fixed offset.

# Dash Direction Controller
entities.WarlockHelper/DashDirController.placements.name.normal=Dash Direction Controller (Matrix)
entities.WarlockHelper/DashDirController.placements.name.map=Dash Direction Controller (Replace)
entities.WarlockHelper/DashDirController.placements.description.normal=Controller which alters the direction and speed of the player's dash.
entities.WarlockHelper/DashDirController.placements.description.map=Controller which alters the direction and speed of the player's dash.
entities.WarlockHelper/DashDirController.attributes.description.direction=Changes the dash direction. First 4 values are 2x2 matrix elements, 2 optional values after are a fixed offset.
entities.WarlockHelper/DashDirController.attributes.description.neutral=Dash direction when the player isn't holding a direction (only when Override Neutral is enabled)
entities.WarlockHelper/DashDirController.attributes.description.overrideNeutral=Whether not holding a direction should dash forwards or in a custom direction
entities.WarlockHelper/DashDirController.attributes.description.flipNeutral=Whether to flip neutral dash direction horizontally when player is facing left